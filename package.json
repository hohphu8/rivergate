{
  "name": "rivergate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/app.js",
    "server": "node server/app.js",
    "dev": "vite --host 127.0.0.1 --port 4210 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4211 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:online": "playwright test -c playwright.online.config.js",
    "check": "npm test && npm run build && npm run test:e2e && npm run test:online"
  },
  "dependencies": {
    "gyosjs": "0.5.6"
  },
  "devDependencies": {
    "vite": "6.4.6",
    "@playwright/test": "1.55.1"
  }
}
